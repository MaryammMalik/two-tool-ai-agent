# Copy this file to ".env" and add your own key to let a real LLM
# (OpenAI, function calling — see Module 8) plan the agent's actions.
# Without a key, a deterministic offline scripted planner is used:
# the loop, tools, logging and step limit work exactly the same.
OPENAI_API_KEY=your_openai_api_key_here

# Optional override:
# OPENAI_MODEL=gpt-4o-mini
